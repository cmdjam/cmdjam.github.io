{
  "id": "./",
  "name": "Tessera Day",
  "short_name": "Tessera",
  "description": "Time tracking as a mosaic: paint your day in coloured tiles.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ECEFF3",
  "theme_color": "#1B2430",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#/day", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "This week", "url": "./#/week", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mosaic", "url": "./#/mosaic", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
